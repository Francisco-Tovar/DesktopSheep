<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KawaiiDesktopPets</AssemblyName>
    <RootNamespace>KawaiiDesktopPets</RootNamespace>
    <ApplicationIcon>sheep.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Authors>Thovarisk</Authors>
    <Company>Thovarisk</Company>
    <Product>KawaiiDesktopPets</Product>
    <Description>KawaiiDesktopPets — Developed by Thovarisk</Description>
    <Copyright>Developed by Thovarisk</Copyright>
    <RepositoryUrl>https://github.com/Francisco-Tovar/DesktopSheep</RepositoryUrl>
    <DefaultItemExcludes>$(DefaultItemExcludes);macOS\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="sheep_spritesheet_1024x640.png" />
    <Resource Include="dachshound.png" />
    <Resource Include="schnauzer.png" />
    <Resource Include="chick.png" />
    <Resource Include="cow.png" />
    <Resource Include="toby.png" />
    <Resource Include="santa_hat.png" />
    <Resource Include="sheep.ico" />
    <Resource Include="KawaiiDesktopPets_SFX\*.wav" />
  </ItemGroup>

</Project>
